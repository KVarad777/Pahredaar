# =============================================================================
# PROJECT AEGIS: .gitignore Configuration
# =============================================================================

# 1. Byte-compiled / optimized / runtime files (Python)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# 2. Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. C++ Build artifacts, Object files, Binaries & CMake caches
cpp/build/
build/
bin/
out/
*.obj
*.o
*.out
*.exe
*.dll
*.dylib
*.pdb
*.ilk
*.exp
*.lib
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
CMakeScripts/
Testing/
*.ninja
.ninja_*

# 4. Environment variables, secrets & credentials
.env
.env.*
!.env.example
secrets.toml
config.local.*

# 5. IDE & Editor Specific Files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 6. Jupyter Notebook & Testing caches
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# 7. Streamlit & Web App caches
.streamlit/cache/
.streamlit/secrets.toml

# 8. Large Logs & Temporary Sockets / Dumps
logs/
*.log
*.sock
*.ipc
*.tmp
*.temp
