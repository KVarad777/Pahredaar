# =============================================================================
# PROJECT AEGIS: .gitignore Configuration
# Mastercard Innovation Challenge @ Global Fintech Fest 2026
# =============================================================================

# 1. Datasets & Large Data Files (Ignore all CSV and Parquet)
*.csv
*.parquet
*.feather
*.h5
*.pkl
*.joblib
!models/*.joblib
!models/*.json

# Explicitly ignore data folders except .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/held_out_attacks/
data/synthetic/

# 2. Python runtime & environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# 3. Environment variables, secrets & credentials
.env
.env.*
!.env.example
secrets.toml
config.local.*

# 4. C++ Build artifacts, Object files, Binaries & CMake caches
cpp/build/
build/
bin/
out/
*.obj
*.o
*.out
*.exe
*.dll
*.dylib
*.pdb
*.ilk
*.exp
*.lib
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
CMakeScripts/
Testing/
*.ninja
.ninja_*

# 5. IDE & Editor Specific Files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# 6. Jupyter Notebook & Testing caches
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# 7. Streamlit & Web App caches
.streamlit/cache/
.streamlit/secrets.toml

# 8. Large Logs & Temporary Sockets / Dumps
logs/
*.log
*.sock
*.ipc
*.tmp
*.temp
*.zip
*.docx
